diff --git a/ps5-kstuff/uelf/kekcall.c b/ps5-kstuff/uelf/kekcall.c
index 525c774..cf7e336 100644
--- a/ps5-kstuff/uelf/kekcall.c
+++ b/ps5-kstuff/uelf/kekcall.c
@@ -99,6 +99,29 @@ int handle_kekcall(uint64_t* regs, uint64_t* args, uint32_t nr)
             args[RAX] = result;
         return err;
     }
+    else if(nr == 8)
+    {
+        /* KREAD(dst_user, kva, size): read-only kernel memory -> caller.
+         * Diagnostic primitive for locating kernel text/rodata sites. */
+        uint64_t dst = args[RDI];
+        uint64_t src = args[RSI];
+        uint64_t sz = args[RDX];
+        static uint8_t bounce[65536];
+        if(!sz || sz > sizeof(bounce))
+            return EINVAL;
+        if(copy_from_kernel(bounce, src, sz))
+            return EFAULT;
+        if(copy_to_kernel(dst, bounce, sz))
+            return EFAULT;
+        args[RAX] = sz;
+        return 0;
+    }
+    else if(nr == 9)
+    {
+        /* Publish the runtime kernel data anchor (kdata_base). */
+        args[RAX] = shared_area.kdata_base_pub;
+        return 0;
+    }
     else if(nr == 0xffffffff)
     {
         args[RAX] = 0;
