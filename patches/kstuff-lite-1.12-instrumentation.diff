+static void kstage(const char *m, long v)
+{
+    char b[160];
+    int n = 0;
+    const char *p = "<118>[kstage] ";
+    while (*p && n < (int)sizeof(b) - 40) b[n++] = *p++;
+    while (*m && n < (int)sizeof(b) - 40) b[n++] = *m++;
+    if (v >= 0) {
+        char t[24]; int k = 0;
+        unsigned long u = (unsigned long)v;
+        b[n++] = '=';
+        if (!u) b[n++] = '0';
+        while (u) { t[k++] = (char)('0' + (u % 10)); u /= 10; }
+        while (k) b[n++] = t[--k];
+    }
+    b[n++] = '\n';
+    b[n] = 0;
+    syscall(0x259, 7, b, 0);
+}
+
 int main(void* ds, int a, int b, uintptr_t c, uintptr_t d)
 {
